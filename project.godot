[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_2="player"
2d_physics/layer_3="enemy"

[rendering]

environment/defaults/default_clear_color=Color(0.02, 0.02, 0.08, 1)
